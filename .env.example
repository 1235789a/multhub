# ============================================================
# Firebase Configuration (Required for Firestore)
# ============================================================
# Firebase Project ID (公开信息)
FIREBASE_PROJECT_ID=multhub-10397

# Firebase Client Email (公开信息)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@multhub-10397.iam.gserviceaccount.com

# Firebase Private Key (敏感！必须通过以下方式注入)
# 不要在这里填写真实密钥！
# - 本地开发：使用 wrangler secret put FIREBASE_PRIVATE_KEY
# - Cloudflare：在 Dashboard → Workers → Settings → Variables and Secrets 中添加
# - Vercel：在 Environment Variables 中添加
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================
# AI API Keys (Required for AI features)
# ============================================================
# DeepSeek API (Recommended for tariff, partnership, viral campaign tools)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# ============================================================
# AI Image Generation (Required for Token Poster)
# ============================================================
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_api_key_here
AI_IMAGE_MODEL=dall-e-3

# ============================================================
# License Bypass (Development only - NEVER set to 1 in production!)
# ============================================================
# VIRAL_CAMPAIGN_PLANNER_LICENSE_BYPASS=1
# TOKEN_POSTER_LICENSE_BYPASS=1
# TARIFF_LENS_LICENSE_BYPASS=1
# PARTNERSHIP_ANNOUNCEMENT_LICENSE_BYPASS=1

# ============================================================
# Optional: Proxy Configuration (For development behind firewall)
# ============================================================
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
