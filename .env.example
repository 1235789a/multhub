FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI / LLM Keys
PARTNERSHIP_API_KEY=your_api_key_here
IMAGE_API_KEY=your_api_key_here
IMAGE_MODEL=deepseek-chat

# Image Provider (optional - for real image generation)
# If not set or = prompt_only, only prompt/visual brief output is available
IMAGE_PROVIDER=prompt_only
# IMAGE_API_KEY must be set above to enable real image generation
# Supports OpenAI-compatible APIs (DALL-E, etc.)
IMAGE_API_BASE_URL=https://api.openai.com/v1

