# Firebase (Firestore REST)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI / LLM Keys

# TEXT_* is for prompt/copy/visual brief generation (文字模型).
# Used by: Web3 Content Factory, Web3 Promo Image Factory (prompt only),
#          Partnership Announcement Generator, Tariff Lens.
TEXT_PROVIDER=openai_compatible
TEXT_API_KEY=your_text_api_key_here
TEXT_API_BASE_URL=https://your-text-api-endpoint.example.com
TEXT_MODEL=deepseek-chat

# Legacy fallback keys (not recommended for new deployments)
PARTNERSHIP_API_KEY=your_api_key_here

# IMAGE_* is only for real image generation (图片模型).
# Used only by: image-provider.ts (Web3 Promo Image Factory)
# If IMAGE_PROVIDER=prompt_only, no real image will be generated.
IMAGE_PROVIDER=prompt_only
IMAGE_API_KEY=your_image_api_key_here
IMAGE_API_BASE_URL=https://your-image-api-endpoint.example.com
IMAGE_MODEL=your_image_model_here

# USDT TRC20
USDT_RECEIVE_ADDRESS=TWiDbdetRhXF3cnMHciM1EK8AjTPKHMjJF

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# License Bypass (LOCAL DEV ONLY - NEVER set in production)
PARTNERSHIP_ANNOUNCEMENT_LICENSE_BYPASS=0
TARIFF_LENS_LICENSE_BYPASS=0
