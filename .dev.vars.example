# Local development only. Copy to .dev.vars and never commit the real file.
ENVIRONMENT=development
SITE_URL=http://localhost:8787
BRAND_NAME=Handmade Visibility
PUBLIC_USDT_NETWORK=TRC20
PUBLIC_USDT_ADDRESS=replace_me
ADMIN_EMAILS=you@example.com
ADMIN_NOTIFY_EMAIL=you@example.com
FROM_EMAIL=Handmade Visibility <hello@your-domain.com>
DEV_ADMIN_BYPASS=true

# Production secrets: set with `wrangler secret put NAME`.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=
