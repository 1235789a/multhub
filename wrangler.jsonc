{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multhub",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handmade-visibility",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PRODUCT_ASSETS",
      "id": "2c8aa947b58c4507b8343cfa56abea4d"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://multhub.top",
    "BRAND_NAME": "Handmade Visibility",
    "PUBLIC_USDT_NETWORK": "TRC20",
    "PUBLIC_USDT_ADDRESS": "TWiDbdetRhXF3cnMHciM1EK8AjTPKHMjJF",
    "ADMIN_EMAILS": "",
    "FROM_EMAIL": "Handmade Visibility <hello@example.com>",
    "ADMIN_NOTIFY_EMAIL": "",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "TURNSTILE_SITE_KEY": ""
  },
  "triggers": {
    "crons": ["0 1 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
