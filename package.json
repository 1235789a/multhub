{
  "name": "handmade-visibility",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cf-build": "npm run check",
    "cf-deploy": "npm run db:migrate:remote && wrangler versions upload",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply handmade-visibility --local",
    "db:migrate:remote": "wrangler d1 migrations apply handmade-visibility --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run deploy:dry"
  },
  "dependencies": {
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260715.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  },
  "engines": {
    "node": ">=20"
  }
}
