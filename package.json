{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "cf-build": "npm run build",
    "start": "vinext start",
    "test": "npm run build && npm run test:visibility && node scripts/visibility/test-render.mjs && node --import tsx --test tests/payment-verification.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:visibility": "vitest run --config vitest.visibility.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "^2.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "^1.2.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "type": "module",
  "overrides": {
    "fflate": "^0.8.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
